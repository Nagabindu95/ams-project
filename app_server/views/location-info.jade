extends layout
include _includes/sharedHTMLfunctions

block content
  .row.banner
    .col-12
      h1= pageHeader.title

  .row
    .col-12.col-lg-9
      .card.mb-4
        .card-body
          if location.imageSrc
            img.img-fluid.rounded.hospital-detail-image(src=location.imageSrc, alt='#{location.name}')
          else
            .bg-light.d-flex.align-items-center.justify-content-center.rounded(style='width: 100%; height: 300px;')
              i.fa.fa-hospital.text-muted.fa-3x
          
          .row.mt-4
            .col-12.col-md-6
              .rating
                +outputRating(location.rating)
                span.ml-2 (#{location.rating}/5)
              p.address
                i.fa.fa-map-marker-alt.mr-2
                = location.address
              
              .card.card-primary.mb-4
                .card-body
                  h2.card-title 
                    i.fa.fa-clock.mr-2
                    | Opening Hours
                  each time in location.openingTimes
                    .d-flex.justify-content-between.mb-2
                      strong= time.days
                      if time.closed
                        span.text-danger Closed
                      else
                        if time.opening == '24/7'
                          span.text-success Open 24 Hours
                        else
                          span #{time.opening} - #{time.closing}
            
            .col-12.col-md-6
              .card.card-primary.mb-4
                .card-body
                  h2.card-title 
                    i.fa.fa-concierge-bell.mr-2
                    | Facilities
                  .row
                    each facility in location.facilities
                      .col-12.col-sm-6.mb-2
                        i.fa.fa-check.text-success.mr-2
                        = facility
              
              .card.card-primary
                .card-body
                  h2.card-title 
                    i.fa.fa-address-card.mr-2
                    | Contact Information
                  if location.contact
                    if location.contact.phone
                      p
                        i.fa.fa-phone.mr-2
                        strong Phone: 
                        = location.contact.phone
                    if location.contact.gmail
                      p
                        i.fa.fa-envelope.mr-2
                        strong Email: 
                        a(href=`mailto:${location.contact.gmail}`)= location.contact.gmail
                    if location.contact.website
                      p
                        i.fa.fa-globe.mr-2
                        strong Website: 
                        a(href=location.contact.website, target="_blank")= location.contact.website
                  else
                    p No contact information available
          
          .card.card-primary
            .card-body
              h2.card-title 
                i.fa.fa-map.mr-2
                | Location
              if location.coords
                p
                  i.fa.fa-map-marker-alt.mr-2
                  strong Coordinates: 
                  | #{location.coords.lat.toFixed(4)}, #{location.coords.lng.toFixed(4)}
                .map-container.mt-3
                  iframe(width='100%', height='350', frameborder='0', scrolling='no', marginheight='0', marginwidth='0', src=`https://www.openstreetmap.org/export/embed.html?bbox=${location.coords.lng - 0.01}%2C${location.coords.lat - 0.01}%2C${location.coords.lng + 0.01}%2C${location.coords.lat + 0.01}&layer=mapnik&marker=${location.coords.lat}%2C${location.coords.lng}`)
              else
                if location.imageSrc
                  img.img-fluid.rounded(src=location.imageSrc, alt='#{location.name} Location', style='width: 100%; height: 350px; object-fit: contain; object-position: center; background-color: #f0f0f0;')
                else
                  .bg-light.d-flex.align-items-center.justify-content-center.rounded(style='width: 100%; height: 350px;')
                    i.fa.fa-map.text-muted.fa-3x
                    p.text-muted.mt-3 Location map not available

  .row
    .col-12
      .card.card-primary.review-card
        .card-body
          .d-flex.justify-content-between.align-items-center.mb-4
            h2.card-title 
              i.fa.fa-comments.mr-2
              | Patient Reviews
            a.btn.btn-primary(href=`/location/${location.name.replace(/\s/g, '-')}/review/new`)
              i.fa.fa-plus.mr-1
              | Add Review
          
          each review in location.reviews
            .card.mb-3.review-item
              .card-body
                .review-header
                  .d-flex.align-items-center
                    .rating.mr-3
                      +outputRating(review.rating)
                    .review-info
                      strong.reviewAuthor= review.author
                      br
                      small.reviewTimestamp
                        i.fa.fa-calendar.mr-1
                        = new Date(review.timestamp).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                  p.mt-3 !{(review.reviewText).replace(/\n/g, '<br/>')}
          
          if location.reviews.length === 0
            .text-center.py-5
              i.fa.fa-comment-slash.fa-3x.text-muted.mb-3
              h4 No reviews yet
              p Be the first to share your experience with #{location.name}
              a.btn.btn-primary(href=`/location/${location.name.replace(/\s/g, '-')}/review/new`)
                i.fa.fa-plus.mr-1
                | Write a Review