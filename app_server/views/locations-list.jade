extends layout
include _includes/sharedHTMLfunctions

block content
  .row.banner
    .col-12
      h1= pageHeader.title
      small.tagline #{pageHeader.strapline}

  .row
    .col-12.col-md-8
      .row
        .col-12
          .card.mb-4
            .card-body
              h2.card-title 
                i.fa.fa-hospital.mr-2
                | Featured Hospitals
              p Find the best medical facilities in Hyderabad with our comprehensive directory. All hospitals are verified and rated by patients.
      
      each location in locations
        .card.mb-4.location-card(data-location=location.name)
          .card-body
            .row
              .col-12.col-md-4.mb-3.mb-md-0.d-flex.align-items-center.justify-content-center
                if location.imageSrc
                  img.img-fluid.rounded.hospital-image(src=location.imageSrc, alt='#{location.name}', loading='lazy')
                else
                  .bg-light.d-flex.align-items-center.justify-content-center.h-100.rounded
                    i.fa.fa-hospital.text-muted.fa-2x
              
              .col-12.col-md-8
                h4
                  a.locName(href=`/location/${location.name.replace(/\s+/g, '-').toLowerCase()}`)= location.name
                
                .rating
                  +outputRating(location.rating)
                  span.ml-2 (#{location.rating}/5)
                
                p.address
                  i.fa.fa-map-marker-alt.mr-2
                  = location.address
                
                .facilities.mb-3
                  h5 
                    i.fa.fa-check-circle.mr-2
                    | Key Facilities
                  each facility in location.facilities.slice(0, 4)
                    span.badge.badge-warning.mr-2.mb-1= facility
                  if location.facilities.length > 4
                    span.badge.badge-secondary +#{location.facilities.length - 4} more
                
                .contact-info.mb-3
                  if location.contact && location.contact.phone
                    p.mb-1
                      i.fa.fa-phone.mr-2
                      strong Phone: 
                      = location.contact.phone
                  if location.contact && location.contact.gmail
                    p.mb-1
                      i.fa.fa-envelope.mr-2
                      strong Email: 
                      a(href=`mailto:${location.contact.gmail}`)= location.contact.gmail
                
                .d-flex.justify-content-between.align-items-center.mt-auto
                  a.btn.btn-primary(href=`/location/${location.name.replace(/\s+/g, '-').toLowerCase()}`)
                    i.fa.fa-info-circle.mr-1
                    | View Details
                  span
                    i.fa.fa-user.mr-1
                    | #{location.reviews.length} reviews

    .col-12.col-md-4
      .card.sticky-top
        .card-body
          h3 
            i.fa.fa-info-circle.mr-2
            | About Appointment Booking System
          p.lead= sidebar
          hr
          h4 
            i.fa.fa-star.mr-2
            | Why Choose Us?
          ul
            li Verified hospital information
            li Real patient reviews
            li Easy appointment booking
            li Comprehensive facility details
            li Accurate location maps
          .text-center.mt-4
            a.btn.btn-primary(href='/about/')
              i.fa.fa-book.mr-1
              | Learn More

  // Quick Stats Section
  .row.mt-4
    .col-12
      .card
        .card-body
          .row.text-center
            .col-6.col-md-3.mb-3.mb-md-0
              h2 
                i.fa.fa-hospital.text-primary
              h4= locations.length
              p Hospitals Listed
            .col-6.col-md-3.mb-3.mb-md-0
              h2 
                i.fa.fa-user-md.text-success
              h4 50+
              p Medical Specialists
            .col-6.col-md-3
              h2 
                i.fa.fa-calendar-check.text-info
              h4 1000+
              p Appointments Booked
            .col-6.col-md-3
              h2 
                i.fa.fa-star.text-warning
              h4 4.5
              p Average Rating